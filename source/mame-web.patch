+// StarBlade HD: polygons rasterize directly at 1920x1080. C355 sprites retain
+// the original 496x480 raster and map into a centred 1440x1080 (4:3) rectangle.
+// The original mix callback still resolves palette, shadow and priority rules.
+void namcos21_c67_state::mix_hd_sprites(bitmap_ind16 &bitmap, int priority, bool depth_test)
+{
+    const bitmap_ind16 &sprites = m_c355spr->render_bitmap();
+    const int width = bitmap.width();
+    const int left = (width - 1440) / 2;
+    const u16 *depth = m_namcos21_3d->get_visible_zbuffer();
+    const u16 colorbase = m_c355spr->gfx(0)->colorbase();
+    u16 pri[16];
+    for (int i = 0; i < 16; ++i)
+        pri[i] = i == 0 ? 0x7fc0 : pri[i - 1] / 1.24;
+    for (int sy = 0; sy < 480; ++sy)
+    {
+        const u16 *src = &sprites.pix(sy);
+        const int y0 = (sy * 1080 + 479) / 480;
+        const int y1 = ((sy + 1) * 1080 + 479) / 480;
+        for (int sx = 0; sx < 496; ++sx)
+        {
+            const u16 raw = src[sx];
+            if (raw == 0xffff || ((raw >> 12) & 3) != priority)
+                continue;
+            // ST2 tile 0x27a is the solid damage flash. Extend only its
+            // surviving edge pixels; the centre retains original sprite order.
+            const bool flash = priority == 3 && m_c355spr->effect_bitmap().pix(sy, sx) == 2;
+            const int x0 = flash && sx == 0 ? 0 : left + (sx * 1440 + 495) / 496;
+            const int x1 = flash && sx == 495 ? width : left + ((sx + 1) * 1440 + 495) / 496;
+            for (int y = y0; y < y1; ++y)
+            {
+                u16 *dst = &bitmap.pix(y);
+                const u16 *z = depth + y * width;
+                for (int x = x0; x < x1; ++x)
+                {
+                    u16 mixed = dst[x];
+                    u8 destpri = 0;
+                    if (!sprite_mix_callback(mixed, destpri, colorbase, raw & 0xfff, (raw >> 12) & 0xf, priority))
+                        continue;
+                    if (!depth_test || ((mixed & 0x5000) && pri[(mixed >> 8) & 0xf] <= z[x]) || mixed < 0x1000)
+                        dst[x] = m_ui_scanlines && priority == 3 && mixed >= 0x1000 && mixed < 0x2000
+                            && m_c355spr->effect_bitmap().pix(sy, sx) == 1 && y == y1 - 1
+                            ? 0x8000 | (mixed & 0xfff) : mixed;
+                }
+            }
+        }
+    }
+}
+
+// Scene sprites retain the original 496-pixel projection and pixel size.  The
+// auxiliary surface exposes the selected native coordinate range that the
+// arcade clip window discarded; it does not spread the 4:3 picture.
+void namcos21_c67_state::mix_hd_wide_sprites(bitmap_ind16 &bitmap, int priority, bool depth_test)
+{
+    const bitmap_ind16 &sprites = m_c355spr->auxiliary_bitmap();
+    const int width = bitmap.width();
+    const int left = (width - 1440) / 2;
+    const int auxiliary_width = sprites.width();
+    const int auxiliary_offset = (auxiliary_width - 496) / 2;
+    const int base = left - (auxiliary_offset * 1440 + 248) / 496;
+    const u16 *depth = m_namcos21_3d->get_visible_zbuffer();
+    const u16 colorbase = m_c355spr->gfx(0)->colorbase();
+    u16 pri[16];
+    for (int i = 0; i < 16; ++i)
+        pri[i] = i == 0 ? 0x7fc0 : pri[i - 1] / 1.24;
+    for (int sy = 0; sy < 480; ++sy)
+    {
+        const u16 *src = &sprites.pix(sy);
+        const int y0 = (sy * 1080 + 479) / 480;
+        const int y1 = ((sy + 1) * 1080 + 479) / 480;
+        for (int sx = 0; sx < auxiliary_width; ++sx)
+        {
+            const u16 raw = src[sx];
+            if (raw == 0xffff || ((raw >> 12) & 3) != priority)
+                continue;
+            const int x0 = std::max(0, base + (sx * 1440 + 495) / 496);
+            const int x1 = std::min(width, base + ((sx + 1) * 1440 + 495) / 496);
+            for (int y = y0; y < y1; ++y)
+            {
+                u16 *dst = &bitmap.pix(y);
+                const u16 *z = depth + y * width;
+                for (int x = x0; x < x1; ++x)
+                {
+                    u16 mixed = dst[x];
+                    u8 destpri = 0;
+                    if (!sprite_mix_callback(mixed, destpri, colorbase, raw & 0xfff, (raw >> 12) & 0xf, priority))
+                        continue;
+                    if (!depth_test || ((mixed & 0x5000) && pri[(mixed >> 8) & 0xf] <= z[x]) || mixed < 0x1000)
+                        dst[x] = mixed;
+                }
+            }
+        }
+    }
+}
+
+u32 namcos21_c67_state::screen_update_hd(screen_device &screen, bitmap_ind16 &bitmap, const rectangle &cliprect)
+{
+    if (cliprect.top() == 0) m_hd_frame = m_hd_present_frame ^ 1U;
+    bitmap_ind16 &output = m_hd_bitmap[m_hd_frame];
+    m_c355spr->set_explosion_mode(!m_solvalou_hd && (ioport("HD_EXPLOSION_MODE")->read() & 1) != 0,
+        (ioport("HD_RENDER_STYLE")->read() & 1) != 0);
+    const rectangle native_clip(0, 495, 0, 479);
+    m_namcos21_3d->set_wireframe((ioport("HD_RENDER_STYLE")->read() & 1) != 0);
+    m_namcos21_3d->set_wire_width((ioport("HD_WIRE_WIDTH")->read() & 7) * 0.5);
+    m_namcos21_3d->set_wireframe((ioport("HD_RENDER_STYLE")->read() & 1) != 0);
+    starblade_gpu::requested = (ioport("HD_GPU")->read() & 1) != 0;
+    std::shared_ptr<const starblade_gpu::frame> completed_packet;
+    const bool gpu = starblade_gpu::requested && starblade_gpu::available && m_namcos21_3d->gpu_frame();
+    ++m_gpu_serial;
+    const unsigned glow_strength = m_solvalou_hd ? 0 : (ioport("HD_UI_GLOW")->read() & 3);
+    m_ui_scanlines = glow_strength ? 0 : (ioport("HD_UI")->read() & 3);
+    if (m_ui_scanlines)
+        for (int pen = 0; pen < 0x1000; ++pen)
+            m_palette->set_pen_color(0x8000 + pen,
+                starblade_scanline_color(m_palette->pen_color(0x1000 + pen), m_ui_scanlines));
+    if (!BIT(m_video_enable, 6))
+        output.fill(m_palette->black_pen());
+    else
+    {
+        output.fill(0xff);
+        screen.priority().fill(0, native_clip);
+        m_c355spr->build_sprite_list_and_render_sprites(native_clip);
+        m_title_visible = !m_solvalou_hd && m_c355spr->title_stars_present();
+        m_hud_visible = false;
+        for (int y = 40; y < 90 && !m_hud_visible && !m_solvalou_hd; ++y)
+            for (int x = 200; x < 300; ++x)
+                if (m_c355spr->effect_bitmap().pix(y, x) == 1)
+                { m_hud_visible = true; break; }
+        const u16 pri1 = (m_palette->read16_ext(0) >> 8) & 7;
+        if (gpu) {
+            auto packet = starblade_gpu::acquire_frame();
+            packet->serial = m_gpu_serial;
+            packet->solvalou_crop = m_solvalou_hd;
+            packet->solvalou_status = m_solvalou_hd && (ioport("SV_STATUS")->read() & 1);
+            packet->width = output.width();
+            packet->height = output.height();
+            packet->spans = m_namcos21_3d->gpu_spans();
+            packet->sprites.resize(496 * 480);
+            for (int y = 0; y < 480; ++y) for (int x = 0; x < 496; ++x)
+                packet->sprites[y * 496 + x] = m_c355spr->render_bitmap().pix(y, x) | (u32(m_c355spr->effect_bitmap().pix(y, x)) << 16);
+            packet->auxiliary_width = m_c355spr->auxiliary_bitmap().width();
+            const int auxiliary_offset = (packet->auxiliary_width - 496) / 2;
+            packet->auxiliary_base = (int(packet->width) - 1440) / 2
+                - (auxiliary_offset * 1440 + 248) / 496;
+            packet->wide_sprites.resize(packet->auxiliary_width * 480);
+            for (int y = 0; y < 480; ++y)
+                std::copy_n(&m_c355spr->auxiliary_bitmap().pix(y), packet->auxiliary_width,
+                    packet->wide_sprites.data() + y * packet->auxiliary_width);
+            const rgb_t *palette = m_palette->palette()->entry_list_adjusted();
+            packet->palette.assign(palette, palette + 0x9000);
+            packet->depth_test = pri1 != 0 && pri1 != 2;
+            packet->scanlines = m_ui_scanlines;
+            packet->glow_strength = glow_strength;
+            packet->wire_glow_radius = ioport("HD_WIRE_GLOW_RADIUS")->read() & 0x0f;
+            packet->wire_glow_level = ioport("HD_WIRE_GLOW_LEVEL")->read() & 0x03;
+            packet->wire_brightness = ioport("HD_WIRE_BRIGHTNESS")->read() & 0x03;
+            packet->vector_effect = (ioport("HD_VECTOR_EFFECT")->read() & ioport("HD_RENDER_STYLE")->read() & 1);
+            completed_packet = std::move(packet);
+        } else {
+            mix_hd_wide_sprites(output, 2, false);
+            m_namcos21_3d->copy_visible_poly_framebuffer(output, output.cliprect());
+            mix_hd_wide_sprites(output, 0, pri1 != 0 && pri1 != 2);
+            mix_hd_wide_sprites(output, 3, false);
+            mix_hd_sprites(output, 3, false);
+        }
+    }
+    if (m_solvalou_hd && !gpu) {
+        const int width = output.width();
+        m_solvalou_source_pixels.resize(width * 1080);
+        for (int y = 0; y < 1080; ++y)
+            std::copy_n(&output.pix(y), width, m_solvalou_source_pixels.data() + y * width);
+        const bool status = (ioport("SV_STATUS")->read() & 1) != 0;
+        starblade_gpu::solvalou_present(m_solvalou_source_pixels, width, status,
+            [&](u16 pen) -> u32 { return m_palette->pen_color(pen); });
+        for (int y = 0; y < 1080; ++y)
+            std::copy_n(m_solvalou_source_pixels.data() + y * width, width, &output.pix(y));
+    }
+    // Maintain the ordinary screen bitmap for MAME's native snapshot path.
+    for (int y = cliprect.top(); y <= cliprect.bottom(); ++y)
+        for (int x = cliprect.left(); x <= cliprect.right(); ++x)
+            bitmap.pix(y, x) = output.pix(y * 1080 / 480, x * m_hd_width / 496);
+    if (cliprect.bottom() == 479)
+    {
+        starblade_gpu::publish(output, std::move(completed_packet));
+        m_hd_present_frame = m_hd_frame;
+        screen.set_presentation_bitmap(m_hd_bitmap[m_hd_present_frame]);
+        screen.set_presentation_overlay(nullptr);
+        if (glow_strength && BIT(m_video_enable, 6))
+        {
+            auto &rgb = m_hd_rgb_bitmap[m_hd_present_frame];
+            if (!gpu || !starblade_gpu::glow_available)
+                m_ui_glow->render(rgb, m_c355spr->render_bitmap(),
+                    m_c355spr->effect_bitmap(), m_palette->palette()->entry_list_adjusted(), glow_strength);
+            screen.set_presentation_overlay(&rgb);
+        }
+    }
+    return 0;
+}
