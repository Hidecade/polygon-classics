+// Materialize CPU surfaces only for fallback/save states, never for GPU display.
+void namcos21_3d_device::resolve_spans(const std::vector<starblade_gpu::scan_span> &spans, u16 *pens, u16 *depth)
+{
+    std::fill_n(pens, m_framebuffer_size, 0);
+    std::fill_n(depth, m_framebuffer_size, 0x8000);
+    std::vector<u16> edge_pens(m_framebuffer_size, 0), edge_depth(m_framebuffer_size, 0x8000);
+    std::vector<u8> edge_coverage(m_framebuffer_size, 0);
+    for (auto &s : starblade_gpu::expand_lines(spans, m_poly_frame_width, m_poly_frame_height)) for (unsigned x = s.pixels.x0; x < s.pixels.x1; ++x) {
+        unsigned i = s.y * m_poly_frame_width + x;
+        if (s.pixels.pen & 0x80000000U) {
+            const u8 coverage = (s.pixels.pen >> 16) & 0xff;
+            if (s.pixels.depth < edge_depth[i] || (s.pixels.depth == edge_depth[i] && coverage > edge_coverage[i])) {
+                edge_depth[i] = s.pixels.depth; edge_pens[i] = s.pixels.pen & 0xffff; edge_coverage[i] = coverage;
+            }
+        } else if (s.pixels.depth < depth[i]) { depth[i] = s.pixels.depth; pens[i] = s.pixels.pen; }
+    }
+    for (int i = 0; i < m_framebuffer_size; ++i)
+        if (edge_depth[i] <= depth[i] && (((i % m_poly_frame_width) * 73 + (i / m_poly_frame_width) * 151) & 255) < edge_coverage[i])
+            pens[i] = edge_pens[i];
+}
+void namcos21_3d_device::resolve_visible_gpu()
+{
+    if (m_gpu_visible_valid && !m_gpu_resolved) {
+        resolve_spans(m_gpu_visible, m_poly_framebuffer_pens2.get(), m_poly_framebuffer_z2.get());
+        m_gpu_resolved = true;
+    }
+}
+void namcos21_3d_device::device_pre_save()
+{
+    resolve_visible_gpu();
+    if (m_gpu_collect) resolve_spans(m_gpu_work, m_poly_framebuffer_pens.get(), m_poly_framebuffer_z.get());
+}
+void namcos21_3d_device::device_post_load()
+{
+    m_wire_stabilizer.clear();
+    m_gpu_collect = m_gpu_visible_valid = m_gpu_resolved = false;
+    m_gpu_work.clear(); m_gpu_visible.clear();
+    starblade_gpu::clear();
+}
